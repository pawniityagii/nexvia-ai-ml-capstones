# Single-service deployment: build the React viewer, then serve it from the
# FastAPI backend so the UI and API share one origin (one Render web service).
# Runs the deterministic fallback predictor - no GPU or trained model needed.

# 1) build the viewer
FROM node:22-slim AS viewer
WORKDIR /viewer
COPY viewer/package.json viewer/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY viewer/ ./
RUN npm run build

# 2) backend that also serves the built viewer
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
    "fastapi>=0.110" "uvicorn[standard]>=0.29" "pydantic>=2.6" \
    "python-multipart>=0.0.9" "pillow>=10.0" "numpy>=1.26" \
    "scikit-image>=0.22" "pydicom>=2.4" "requests>=2.31" "scikit-learn>=1.4"
COPY src ./src
COPY --from=viewer /viewer/dist ./viewer/dist
EXPOSE 8000
# Render provides $PORT.
CMD ["sh", "-c", "uvicorn src.serving.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
